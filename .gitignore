# Binaries
/bin/
/build/bin/
/build/pkg/
/dist-release/
*.exe
*.test
*.out

# Go
/vendor/
coverage.*
go.work
go.work.sum

# Local data
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Frontend
node_modules/
# The frontend builds into ui/shell/dist, which the shell embeds. The
# placeholder keeps go:embed working in a checkout without a UI build.
ui/frontend/dist/
ui/shell/dist/*
!ui/shell/dist/.gitkeep

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Claude Code local settings
.claude/settings.local.json
